# Required — model access via OpenRouter
OPENROUTER_API_KEY=

# Optional — Tavily key for the image strip under web-search answers.
# Leave empty to disable images entirely; nothing else changes.
# Free tier at https://tavily.com (~1000 searches/month, no card).
TAVILY_API_KEY=

# Optional — MongoDB Atlas URI; leave empty for in-memory store
MONGODB_URI=
MONGODB_DB=auctionrouter

# Optional — LangSmith observability
# LANGCHAIN_TRACING_V2=true
# LANGCHAIN_API_KEY=
# LANGCHAIN_PROJECT=auctionrouter
